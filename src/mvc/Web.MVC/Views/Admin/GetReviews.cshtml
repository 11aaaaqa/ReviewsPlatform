@using System.Globalization
@model Web.MVC.Models.View_models.Admin.GetReviewsViewModel
<link rel="stylesheet" href="~/css/admin/units-list.css"/>

<div class="units-page">
    <div>
        @foreach (var review in Model.Reviews)
        {
            <a class="unit-block" asp-controller="Admin" asp-action="GetReviewById" asp-route-reviewId="@review.Id">
                <div class="unit-text">@Html.Raw(review.ShortReview)</div>
                <p>Дата создания: @review.CreatedAt.ToString(CultureInfo.GetCultureInfo("ru-RU"))</p>
            </a>
        }
    </div>
    
    @if (Model.Reviews.Count > 0)
    {
        <div class="pagination">
            @if (Model.CurrentPageNumber == 1)
            {
                <button disabled>Назад</button>
            }
            else
            {
                <a asp-controller="Admin" asp-action="GetReviews" asp-route-pageNumber="@(Model.CurrentPageNumber - 1)">Назад</a>
            }

            @if (Model.IsNextPageExisted)
            {
                <a asp-controller="Admin" asp-action="GetReviews" asp-route-pageNumber="@(Model.CurrentPageNumber + 1)">Вперёд</a>
            }
            else
            {
                <button disabled>Вперёд</button>
            }
        </div>
    }
</div>